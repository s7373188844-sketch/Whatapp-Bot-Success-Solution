# Optional: public URL of this bot; the webhook is auto-registered on startup.
# On Railway, RAILWAY_PUBLIC_DOMAIN is used automatically.
# PUBLIC_URL=https://your-bot.up.railway.app

# Optional: where the SQLite DB lives (point at a Railway Volume mount, e.g. /data)
# DATA_DIR=/data

# Google Gemini AI
